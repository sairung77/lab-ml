   "source": [
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "x = np.array([-2, -1, 0, 1, 2])\n",
    "y = np.array([2, 1, 0, 1, 2])\n",
    "\n",
    "plt.figure(figsize=(6,5))\n",
    "plt.plot(x, y, 'o-r', label=\"y vs x\")\n",
    "plt.title(\"xy\")\n",
    "plt.xlabel(\"x\")\n",
    "plt.ylabel(\"y\")\n",
    "plt.grid(True)\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  }
